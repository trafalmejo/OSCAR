{
  "name": "oscar",
  "productName": "OSCAR",
  "version": "2.0.0",
  "description": "OSCAR creates GUIs to control interactive installations sending OSC",
  "main": "server.js",
  "scripts": {
    "postinstall": "npm --prefix public install",
    "build": "browserify ./public/src/oscar_preview.js ./public/src/oscar_editor.js -o ./public/src/bundle.js",
    "watch": "watchify --debug ./public/src/oscar_preview.js ./public/src/oscar_editor.js -o ./public/src/bundle.js -v",
    "start": "npm run build && node server.js",
    "serve": "node server.js",
    "dev": "concurrently \"npm run watch\" \"nodemon --ignore public/src/bundle.js server.js\"",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/trafalmejo/OSCAR"
  },
  "keywords": [
    "grapesjs",
    "OSC",
    "interactive",
    "installations",
    "Open Sound Control",
    "web editor",
    "multimedia",
    "lighting",
    "vj"
  ],
  "author": "Daniel Castaño",
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "open": "^8.4.2",
    "osc": "^2.4.5",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "browserify": "^17.0.1",
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "watchify": "^4.0.0"
  }
}
