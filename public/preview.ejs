<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <title>OSCAR</title>
    <link rel="icon" href="images/favicon_color.png" />

    <link href="node_modules/grapesjs/dist/css/grapes.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="node_modules/@fontsource-variable/inter/index.css" />

    <link href="css/oscar_theme.css" rel="stylesheet" />
    <link href="css/oscar_tooltip.css" rel="stylesheet" />
    <style>
      /* The preview runs GrapesJS's own preview mode; its "exit preview"
         button would drop a control surface back into an editor. */
      .gjs-off-prv { display: none !important; }
    </style>

    <script src="node_modules/jquery/dist/jquery.min.js"></script>

    <script src="node_modules/socket.io-client/dist/socket.io.js"></script>

    <script src="node_modules/grapesjs/dist/grapes.min.js"></script>
    <script src="node_modules/grapesjs-touch/dist/grapesjs-touch.min.js"></script>
  </head>

  <body>
    <div
      data-gjs-editable="false"
      data-gjs-selectable="false"
      data-gjs-hoverable="false"
      data-gjs-propagate="['editable', 'selectable', 'hoverable']"
      id="gjs-oscar-preview"
      style="height: 0px; overflow: hidden;"
    ></div>

    <!-- OSCAR component types, registered as grapesjs plugins by name. -->
    <script src="src/oscar_socket.js"></script>
    <script src="src/oscar_ip.js"></script>
    <script src="src/bundle.js"></script>
  </body>
</html>
