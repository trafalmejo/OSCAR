<div id="pages-panel" style="display: none;">
  <div class="oscar-pages">
    <p class="oscar-pages-hint">
      A surface can hold several pages — one per fixture group, or per scene.
      Whoever is driving it switches between them from the tabs at the bottom of
      the control surface.
    </p>

    <!-- Filled in by the editor; one row per page. -->
    <ul id="pages-list" class="oscar-page-list"></ul>

    <div class="oscar-pages-add">
      <input
        id="new-page-name"
        class="form-control mr-1"
        type="text"
        placeholder="Name the new page"
        name="page-name"
      />
      <button id="add-page-button" class="btn btn-secondary btn-gradient" type="button">
        Add page
      </button>
    </div>
  </div>
</div>
