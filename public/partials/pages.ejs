<div id="pages-panel" style="display: none;">
  <div class="oscar-pages">
    <div class="oscar-pages-hint">
      A surface can hold several pages: one per fixture group, or per scene.
      On the tablet they appear as tabs along the bottom edge.
    </div>
    <ul id="pages-list" class="oscar-page-list"></ul>
    <div class="oscar-pages-add">
      <input
        id="new-page-name"
        class="form-control"
        type="text"
        maxlength="40"
        placeholder="Name the new page, or leave empty"
      />
      <button id="add-page-button" type="button" class="btn btn-secondary btn-gradient">
        Add page
      </button>
    </div>
  </div>
</div>
