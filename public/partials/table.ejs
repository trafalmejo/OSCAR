<div id="table-panel" style="display: none;">
  <div class="o-spinner" id="loader-table" role="status" aria-label="Working" style="display: none;"></div>
  <div id="table-container">
    <div class="o-table-wrap">
      <table id="projects-table" class="o-table">
        <thead>
          <tr>
            <th scope="col" data-sort="name"><button type="button" class="o-sort">Name</button></th>
            <th scope="col" data-sort="size" class="o-num"><button type="button" class="o-sort">Size</button></th>
            <th scope="col" data-sort="date"><button type="button" class="o-sort">Saved</button></th>
            <th scope="col" class="o-actions"><span class="o-visually-hidden">Actions</span></th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
    <div class="o-projects-form">
      <!-- Hidden, not gone: it carries the picked name for the file-system
           Save (oscarSaveToFile suggests it), and the row selection still
           writes into it. Saving got its own dialog, so nobody types here. -->
      <input
        id="project-name"
        class="o-input"
        type="text"
        name="name"
        style="display: none"
      />
      <%- include('save') %> <%- include('load') %>
    </div>
  </div>
</div>
