<div id="table-panel" style="display: none;">
  <div class="table-panel-label">
    <div class="loader" id="loader-table" style="display: none;"></div>
    <div id="table-container" class="container-fluid text-center">
      <div class="bg-light rounded p-1">
        <table
          id="projects-table"
          class="table table-borderless rounded"
          style="width: 100%;"
        ></table>
      </div>
      <div class="d-flex mt-2 mb-2">
        <input
          id="project-name"
          class="form-control mr-1"
          type="text"
          placeholder="Name your project, or pick one from the list"
          name="name"
          required
        />
        <%- include('save') %> <%- include('load') %>
      </div>
    </div>
  </div>
</div>
